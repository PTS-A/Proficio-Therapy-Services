# Environment Variables Example

# Gemini API Key (Server-side only)
GEMINI_API_KEY=

# Resend Configuration (Server-side email delivery only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Client-Side Public Supabase Configuration (Safe for browser / Vite build)
# VITE_SUPABASE_URL: Your Supabase project URL (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY: Your Supabase public anonymous / publishable key
VITE_SUPABASE_ANON_KEY=

# Server-Side Supabase Configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# CRITICAL SECURITY: SUPABASE_SECRET_KEY is a privileged service-role key.
# It grants administrative database access and MUST NEVER be exposed to frontend code or browser clients.
SUPABASE_SECRET_KEY=

