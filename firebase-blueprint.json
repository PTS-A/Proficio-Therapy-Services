{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "User profile, credentials, and role management record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "accessLevel": { "type": "string", "enum": ["ADMINISTRATOR", "USER"] },
        "systemRole": { "type": "string" },
        "roleTitle": { "type": "string" },
        "department": { "type": "string" },
        "avatar": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Pending Activation"] },
        "mustChangePasswordOnFirstLogin": { "type": "boolean" },
        "hasChangedInitialPassword": { "type": "boolean" },
        "isSuperAdmin": { "type": "boolean" }
      },
      "required": ["id", "name", "email", "accessLevel"]
    },
    "CredentialingRecord": {
      "title": "CredentialingRecord",
      "description": "Credentialing tracking record for a provider and payer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "providerId": { "type": "string" },
        "providerName": { "type": "string" },
        "payerId": { "type": "string" },
        "payerName": { "type": "string" },
        "discipline": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "providerId", "payerId", "status"]
    },
    "Provider": {
      "title": "Provider",
      "description": "Therapy clinician or specialist profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "npi": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["id", "fullName"]
    },
    "Payer": {
      "title": "Payer",
      "description": "Insurance payer or health plan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Location": {
      "title": "Location",
      "description": "Practice clinic or service location",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "LegalEntity": {
      "title": "LegalEntity",
      "description": "Legal operating corporate entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System alerts and notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "title"]
    },
    "StageConfig": {
      "title": "StageConfig",
      "description": "Credentialing lifecycle stage configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Employee": {
      "title": "Employee",
      "description": "General employee organization profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string" },
        "department": { "type": "string" },
        "roleTitle": { "type": "string" },
        "employmentStatus": { "type": "string" }
      },
      "required": ["id", "firstName", "lastName", "email"]
    },
    "ClinicalStaff": {
      "title": "ClinicalStaff",
      "description": "Dedicated clinical staff credentialing and license profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "providerId": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "credentials": { "type": "string" },
        "licenseNumber": { "type": "string" },
        "licenseState": { "type": "string" },
        "npi": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "firstName", "lastName"]
    },
    "CredentialingApplication": {
      "title": "CredentialingApplication",
      "description": "Provider credentialing application tracking record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "providerId": { "type": "string" },
        "clinicalStaffId": { "type": "string" },
        "employeeId": { "type": "string" },
        "payerId": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "providerId", "status"]
    },
    "ApplicationDocument": {
      "title": "ApplicationDocument",
      "description": "Document link and verification record for application",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "applicationId": { "type": "string" },
        "providerId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "documentUrl": { "type": "string" }
      },
      "required": ["id", "applicationId", "name", "documentUrl"]
    },
    "ApplicationComment": {
      "title": "ApplicationComment",
      "description": "Collaboration comments and audit log for application",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "applicationId": { "type": "string" },
        "providerId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "commentText": { "type": "string" },
        "dateCreated": { "type": "string" },
        "timeCreated": { "type": "string" }
      },
      "required": ["id", "applicationId", "commentText", "authorName", "dateCreated", "timeCreated"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "System-wide SLAs, holiday calendar rules, email templates, and administrative settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "data": { "type": "object" }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserAccount",
      "description": "User profiles, roles, and credential management"
    },
    "/system_config/{configId}": {
      "schema": "SystemConfig",
      "description": "System configuration, SLAs, holidays, and administrative templates"
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Dedicated collection for real production employee records"
    },
    "/demo_employees/{employeeId}": {
      "schema": "Employee",
      "description": "Isolated collection for demo employee records accessible strictly by admin@example.com"
    },
    "/clinical_staff/{staffId}": {
      "schema": "ClinicalStaff",
      "description": "Dedicated collection for clinical staff records"
    },
    "/applications/{applicationId}": {
      "schema": "CredentialingApplication",
      "description": "Dedicated collection for credentialing applications"
    },
    "/records/{recordId}": {
      "schema": "CredentialingRecord",
      "description": "Provider credentialing tracking records"
    },
    "/providers/{providerId}": {
      "schema": "Provider",
      "description": "Healthcare providers roster"
    },
    "/payers/{payerId}": {
      "schema": "Payer",
      "description": "Insurance payers and health plans"
    },
    "/documents/{documentId}": {
      "schema": "ApplicationDocument",
      "description": "Dedicated collection for linked credentialing documents"
    },
    "/comments/{commentId}": {
      "schema": "ApplicationComment",
      "description": "Dedicated collection for application comments and notes"
    },
    "/locations/{locationId}": {
      "schema": "Location",
      "description": "Operating clinic and service locations"
    },
    "/entities/{entityId}": {
      "schema": "LegalEntity",
      "description": "Legal contracting entities"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "System and SLA alert notifications"
    },
    "/stage_configs/{stageConfigId}": {
      "schema": "StageConfig",
      "description": "Credentialing workflow stages"
    }
  }
}
