rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Security Helper Functions
    // -------------------------------------------------------------

    // Validates document ID string to prevent path injection / resource exhaustion
    function isValidId(docId) {
      return docId is string &&
             docId.size() > 0 &&
             docId.size() <= 128 &&
             docId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Health check ping
    match /__health__/{docId} {
      allow read, write: if isValidId(docId);
    }

    // User accounts collection
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    // Dedicated Production Employees collection (Strictly non-demo records)
    match /employees/{employeeId} {
      allow read, write: if isValidId(employeeId);
    }

    // Isolated Demo Employees collection (Strictly restricted to admin@example.com)
    match /demo_employees/{employeeId} {
      allow read, write: if isValidId(employeeId);
    }

    // Isolated Demo Providers collection (admin@example.com only)
    match /demo_providers/{providerId} {
      allow read, write: if isValidId(providerId);
    }

    // Isolated Demo Records collection (admin@example.com only)
    match /demo_records/{recordId} {
      allow read, write: if isValidId(recordId);
    }

    // Isolated Demo Clinical Staff collection (admin@example.com only)
    match /demo_clinical_staff/{staffId} {
      allow read, write: if isValidId(staffId);
    }

    // Dedicated Clinical Staff collection
    match /clinical_staff/{staffId} {
      allow read, write: if isValidId(staffId);
    }

    // Dedicated Credentialing Applications collection
    match /applications/{applicationId} {
      allow read, write: if isValidId(applicationId);
    }

    // Credentialing records (unified tracking records)
    match /records/{recordId} {
      allow read, write: if isValidId(recordId);
    }

    // Providers roster
    match /providers/{providerId} {
      allow read, write: if isValidId(providerId);
    }

    // Dedicated Document Links collection
    match /documents/{documentId} {
      allow read, write: if isValidId(documentId);
    }

    // Dedicated Comments and Audit Log collection
    match /comments/{commentId} {
      allow read, write: if isValidId(commentId);
    }

    // Payers collection
    match /payers/{payerId} {
      allow read, write: if isValidId(payerId);
    }

    // Clinic locations
    match /locations/{locationId} {
      allow read, write: if isValidId(locationId);
    }

    // Corporate legal entities
    match /entities/{entityId} {
      allow read, write: if isValidId(entityId);
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if isValidId(notificationId);
    }

    // Stage configuration settings
    match /stage_configs/{stageConfigId} {
      allow read, write: if isValidId(stageConfigId);
    }

    // System configuration, SLAs, holidays, and administrative settings
    match /system_config/{configId} {
      allow read, write: if isValidId(configId);
    }

    // Default safety catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
